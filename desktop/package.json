{
  "name": "@reboundops/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Shared macOS and Windows source-checkout Electron shell",
  "main": "app.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test *.test.cjs",
    "package": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.reboundops.desktop",
    "productName": "ReboundOps",
    "asar": true,
    "files": [
      "app.cjs",
      "security.cjs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
