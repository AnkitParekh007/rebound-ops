{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReboundOps",
  "version": "0.2.0",
  "identifier": "org.rebound-ops.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A local-first, private job-search workspace",
    "longDescription": "ReboundOps runs your job search on your own computer: intake, evidence-backed fit, grounded documents and follow-ups. No account; AI is optional.",
    "copyright": "Copyright (c) 2026 Ankit Parekh. MIT License.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../stage/server/": "server/",
      "../stage/web/": "web/",
      "../stage/runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
