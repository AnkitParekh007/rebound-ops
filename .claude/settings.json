{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=require('child_process').spawnSync('graphify',['hook-guard',process.argv[1]],{stdio:'inherit'});process.exit(r.error?(r.error.code==='ENOENT'?0:1):(r.status===null?1:r.status))\" search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=require('child_process').spawnSync('graphify',['hook-guard',process.argv[1]],{stdio:'inherit'});process.exit(r.error?(r.error.code==='ENOENT'?0:1):(r.status===null?1:r.status))\" read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const r=require('child_process').spawnSync('graphify',['hook-guard',process.argv[1]],{stdio:'inherit'});process.exit(r.error?(r.error.code==='ENOENT'?0:1):(r.status===null?1:r.status))\" compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
