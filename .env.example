# This file is a reference, not automatically loaded.
# Guided setup: https://rebound-ops.org/docs/ai/
# Launcher: bash scripts/start-demo.sh --ai (requires an exported key).
# Optional. AI never runs without both explicit flag and server-side API key.
REBOUNDOPS_AI_ENABLED=false
REBOUNDOPS_ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Local request ceiling (default 10). Not a currency spend limit.
# REBOUNDOPS_AI_MAX_ATTEMPTS=10
# Optional explicit counter file. When unset, counters use REBOUNDOPS_DATA_DIR/ai-attempt-counters.json if that dir is set.
# REBOUNDOPS_AI_COUNTER_FILE=/private/path/outside/git/ai-attempt-counters.json
# Never commit actual secrets or personal session backups.

# Optional local disk saving. Requires separate per-session UI consent.
# REBOUNDOPS_DATA_DIR=/private/path/outside/git

# Optional operations features (all off by default; comma-separated flag names).
# REBOUNDOPS_FEATURES=autofill
# Optional local model for operations drafts (docs/adr-0005-local-model.md).
# Loopback only: any other host is refused and never contacted. No API key is sent.
# Autofill pre-fill (engine web app) reads the same variables and REBOUNDOPS_FEATURES
# from its own environment, so set them there too to draft free-text answers locally.
# REBOUNDOPS_LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
# REBOUNDOPS_LOCAL_MODEL=your-local-model-name
# REBOUNDOPS_LOCAL_MODEL_TIMEOUT_MS=30000
