---
/**
 * ReboundOps mark, "the comeback": a small blue hop (the setback) followed by a higher mint
 * rebound that ends in the ball, above a short baseline. Original artwork for this site; the same
 * geometry is used in public/favicon.svg and scripts/make-og-images.mjs.
 */
interface Props { size?: number; withWord?: boolean }
const { size = 28, withWord = true } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9" fill="var(--logo-bg, #090d16)" />
    <path d="M5 25.5 H16" stroke="#eef2f8" stroke-opacity=".3" stroke-width="1.4" stroke-linecap="round" />
    <path d="M5.5 24 Q 8.5 17 11.5 24" fill="none" stroke="#6f93ff" stroke-width="2.4" stroke-linecap="round" />
    <path d="M11.5 24 C 13.5 15, 17.5 9.5, 23 8.2" fill="none" stroke="#3ff0a6" stroke-width="2.6" stroke-linecap="round" />
    <circle cx="25.4" cy="7.8" r="3.1" fill="#3ff0a6" />
  </svg>
  {withWord && <span class="word">Rebound<span>Ops</span></span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; }
  .word { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.03em; }
  .word span { color: var(--accent-ink); }
</style>
