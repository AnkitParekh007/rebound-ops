---
/** Three-way theme control: system → light → dark. Choice stored per browser only. */
---
<button class="theme-toggle" type="button" data-theme-toggle aria-label="Colour theme: system">
  <svg class="i-sys" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
  <svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></g></svg>
  <svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor"/></svg>
</button>

<script>
  const order = ['system', 'light', 'dark'] as const;
  type Mode = (typeof order)[number];
  const root = document.documentElement;
  const read = (): Mode => {
    try {
      const v = localStorage.getItem('rbo-theme');
      return v === 'light' || v === 'dark' ? v : 'system';
    } catch { return 'system'; }
  };
  const apply = (mode: Mode) => {
    if (mode === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', mode);
    try { if (mode === 'system') localStorage.removeItem('rbo-theme'); else localStorage.setItem('rbo-theme', mode); } catch { /* storage unavailable */ }
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
      b.dataset.mode = mode;
      b.setAttribute('aria-label', `Colour theme: ${mode}. Change theme`);
    });
  };
  apply(read());
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) =>
    b.addEventListener('click', () => apply(order[(order.indexOf(read()) + 1) % order.length]!)),
  );
</script>

<style>
  .theme-toggle {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--ink);
    transition: transform var(--dur-base) var(--ease-bounce), border-color var(--dur-quick) var(--ease-out);
  }
  .theme-toggle:hover { border-color: var(--ink); }
  .theme-toggle:active { transform: rotate(-30deg) scale(0.94); }
  .theme-toggle svg { width: 20px; height: 20px; grid-area: 1 / 1; transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .theme-toggle svg { opacity: 0; transform: scale(0.6) rotate(-40deg); }
  .theme-toggle:not([data-mode]) .i-sys,
  .theme-toggle[data-mode='system'] .i-sys,
  .theme-toggle[data-mode='light'] .i-light,
  .theme-toggle[data-mode='dark'] .i-dark { opacity: 1; transform: none; }
</style>
