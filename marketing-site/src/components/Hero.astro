---
import { href } from '../lib/site';
import { CURRENT } from '../data/product';

const scenes = [
  { id: 'discover', label: 'Discover', caption: 'Collect postings by pasting them or looking up a public job board — each one kept with its source.' },
  { id: 'evaluate', label: 'Evaluate', caption: 'See an explainable 0–5 fit score with the evidence behind it, and what you are missing.' },
  { id: 'prepare', label: 'Prepare', caption: 'Tailor a resume and cover letter from facts you verified, then export PDF or DOCX.' },
  { id: 'track', label: 'Track', caption: 'Apply yourself on the official site, confirm it, and keep every follow-up in one trail.' },
];
// Node positions along the arc (viewBox 0 0 400 70), matched to the CSS offset-distance values.
const nodes = [
  { x: 20, y: 58 },
  { x: 140, y: 58 },
  { x: 260, y: 58 },
  { x: 380, y: 58 },
];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap-wide hero-grid">
    <div class="copy">
      <p class="eyebrow">Local-first job search · v{CURRENT.version} pre-release</p>
      <h1 id="hero-title" class="display">Run your job search <span class="hl">on your own computer.</span></h1>
      <p class="lede">
        ReboundOps keeps postings, fit assessments, tailored documents and follow-ups in one private workspace.
        No account, no cloud, and AI only if you want it. You stay the one who applies.
      </p>
      <div class="cta cluster">
        <a class="btn btn-primary" href={href('/download/')}>Download v{CURRENT.version} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={href('/how-it-works/')}>See how it works</a>
      </div>
      <ul class="facts" role="list">
        <li><span class="tick" aria-hidden="true"></span>Free and open source (MIT)</li>
        <li><span class="tick" aria-hidden="true"></span>Works fully with AI off</li>
        <li><span class="tick" aria-hidden="true"></span>Never applies or sends messages for you</li>
      </ul>
    </div>

    <div class="stage-wrap" data-hero>
      <div class="stage panel-dark" data-scene="discover">
        <div class="chrome">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="addr" aria-hidden="true">127.0.0.1:4175</span>
          <span class="synth">synthetic data</span>
          <button type="button" class="play" data-play aria-label="Pause the animation" hidden>
            <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z" fill="currentColor"/></svg>
            <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>
          </button>
        </div>

        <div class="viewport" aria-hidden="true">
          <!-- 1. Discover -->
          <div class="scene s-discover">
            <div class="s-head"><span class="pill">Discover · Greenhouse board</span><span class="pill ghost">3 postings</span></div>
            <div class="job j1"><b>Platform Engineer</b><span>Northwind Labs · Lisbon · hybrid</span><em class="tag lime">Saved to tracker</em></div>
            <div class="job j2"><b>Senior Data Engineer</b><span>Harbor &amp; Pine · Remote (DE)</span><em class="tag">listed 2 days ago</em></div>
            <div class="job j3"><b>Site Reliability Lead</b><span>Quarry Analytics · Austin, TX</span><em class="tag">duplicate?</em></div>
          </div>

          <!-- 2. Evaluate -->
          <div class="scene s-evaluate">
            <div class="gauge">
              <svg viewBox="0 0 120 120"><circle class="track" cx="60" cy="60" r="50" /><circle class="fill" cx="60" cy="60" r="50" pathLength="100" /></svg>
              <div class="score"><b>4.2</b><span>/ 5 fit</span></div>
            </div>
            <div class="crit">
              <div class="row"><span>Role</span><i style="--w:100%"></i></div>
              <div class="row"><span>Required skills</span><i style="--w:80%"></i></div>
              <div class="row"><span>Experience</span><i style="--w:80%"></i></div>
              <div class="row"><span>Published pay</span><i style="--w:60%"></i></div>
              <p class="evidence">“<mark>Kubernetes, Terraform</mark> and Go required”</p>
              <p class="missing"><span class="pill amber">Missing</span> Go — not in your profile</p>
              <p class="elig"><span class="pill tide">Eligibility confirmed</span></p>
            </div>
          </div>

          <!-- 3. Prepare -->
          <div class="scene s-prepare">
            <div class="page p-resume">
              <b>Sam Rivera</b><span class="ln w80"></span><span class="ln w60"></span>
              <span class="sec">Experience</span><span class="ln w90 hi"></span><span class="ln w70 hi"></span><span class="ln w85"></span>
              <span class="sec">Education</span><span class="ln w50"></span>
            </div>
            <div class="page p-letter">
              <span class="ln w40"></span><span class="ln w90"></span><span class="ln w95"></span><span class="ln w70"></span>
              <span class="ph">[[only if true]]</span><span class="ln w60"></span>
            </div>
            <div class="exports"><span class="pill lime">PDF</span><span class="pill lime">DOCX</span><span class="check">Read back: employers, dates, links ✓</span></div>
          </div>

          <!-- 4. Track -->
          <div class="scene s-track">
            <div class="cols">
              <div class="col"><span class="ch">Ready for review</span><div class="card c-move"><b>Platform Engineer</b><span>Northwind Labs</span></div></div>
              <div class="col"><span class="ch">Applied</span><div class="slot"></div></div>
              <div class="col"><span class="ch">Interviewing</span><div class="card c-static"><b>Data Engineer</b><span>Harbor &amp; Pine</span></div></div>
            </div>
            <div class="confirm"><span class="box"></span>I submitted this on the employer’s site</div>
            <div class="trail"><span>May 4 · Saved</span><span>May 6 · Docs exported</span><span class="new">May 7 · Applied (you confirmed)</span></div>
          </div>
        </div>

        <div class="arc">
          <svg class="arc-line" viewBox="0 0 400 70" preserveAspectRatio="none" aria-hidden="true">
            <path class="arc-path" d="M20 58 Q 80 2 140 58 Q 200 2 260 58 Q 320 2 380 58" />
          </svg>
          <span class="ball" aria-hidden="true"></span>
          <div class="steps" role="group" aria-label="Story steps">
            {scenes.map((s, i) => (
              <button type="button" class="step" data-go={s.id} aria-pressed={i === 0 ? 'true' : 'false'} style={`--x:${(nodes[i]!.x / 400) * 100}%`}>
                <span class="node" aria-hidden="true"></span>
                <span class="step-label">{s.label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
      <ol class="captions" role="list">
        {scenes.map((s, i) => (
          <li data-caption={s.id} class={i === 0 ? 'is-active' : ''}><b>{s.label}.</b> {s.caption}</li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { motionOk } from '../scripts/reveal';

  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const steps = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const captions = [...root.querySelectorAll<HTMLElement>('[data-caption]')];
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const order = steps.map((s) => s.dataset.go!);
    let index = 0;
    let timer: number | undefined;
    let userPaused = false;
    let visible = true;
    const DWELL = 4200;

    const show = (i: number) => {
      index = (i + order.length) % order.length;
      const id = order[index]!;
      stage.dataset.scene = id;
      // restart CSS animations in the new scene
      stage.classList.remove('run');
      void stage.offsetWidth;
      stage.classList.add('run');
      steps.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.go === id)));
      captions.forEach((c) => c.classList.toggle('is-active', c.dataset.caption === id));
    };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const start = () => {
      stop();
      if (userPaused || !visible || !motionOk()) return;
      timer = window.setInterval(() => show(index + 1), DWELL);
    };
    const syncPlay = () => {
      const playing = !userPaused && motionOk();
      play.classList.toggle('paused', !playing);
      play.setAttribute('aria-label', playing ? 'Pause the animation' : 'Play the animation');
    };

    steps.forEach((b, i) => b.addEventListener('click', () => { show(i); userPaused = true; syncPlay(); stop(); }));
    play.addEventListener('click', () => { userPaused = !userPaused; syncPlay(); if (userPaused) stop(); else { show(index + 1); start(); } });
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node | null)) start(); });
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; if (visible) start(); else stop(); }, { threshold: 0.2 }).observe(stage);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    if (motionOk()) play.hidden = false;
    syncPlay();
    show(0);
    start();
  }
</script>

<style>
  .hero { position: relative; padding-block: var(--space-xl) var(--space-2xl); overflow: clip; }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60rem 30rem at 85% 10%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%),
      radial-gradient(40rem 26rem at 5% 90%, color-mix(in srgb, var(--signal) 18%, transparent), transparent 70%);
  }
  .hero-grid { display: grid; gap: var(--space-xl); align-items: center; }
  @media (min-width: 1060px) { .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: var(--space-2xl); } }
  .copy { display: grid; gap: var(--space-m); }
  .copy h1 { font-size: var(--step-5); max-width: 13ch; }
  .hl { color: var(--accent-ink); display: inline; background: linear-gradient(transparent 70%, color-mix(in srgb, var(--signal) 55%, transparent) 70%); }
  .cta { --cluster: var(--space-xs); }
  .facts { list-style: none; padding: 0; display: grid; gap: 0.45rem; color: var(--ink-2); font-size: var(--step--1); }
  .facts li { display: flex; align-items: center; gap: 0.6rem; }
  .tick { width: 1.1rem; height: 1.1rem; border-radius: 50%; background: var(--ok-soft); position: relative; flex: none; }
  .tick::after { content: ''; position: absolute; left: 0.36rem; top: 0.2rem; width: 0.3rem; height: 0.55rem; border: solid var(--ok); border-width: 0 2px 2px 0; transform: rotate(45deg); }

  /* ---------- stage ---------- */
  .stage-wrap { display: grid; gap: var(--space-s); min-width: 0; }
  .stage {
    container-type: inline-size; position: relative; overflow: hidden;
    box-shadow: var(--shadow-3); padding: 0 0 0.25rem;
    background:
      radial-gradient(30rem 16rem at 80% 0%, rgb(255 122 77 / 0.16), transparent 70%),
      var(--stage-bg);
  }
  .chrome { display: flex; align-items: center; gap: 0.75rem; padding: 0.8rem 1rem; border-bottom: 1px solid var(--stage-line); font-family: var(--font-mono); font-size: 0.72rem; color: var(--stage-ink-2); }
  .lights { display: inline-flex; gap: 6px; }
  .lights i { width: 10px; height: 10px; border-radius: 50%; background: var(--stage-line); }
  .addr { background: var(--stage-surface); padding: 0.25rem 0.7rem; border-radius: var(--r-pill); }
  .synth { margin-left: auto; color: var(--stage-ink-2); border: 1px dashed var(--stage-line); padding: 0.2rem 0.5rem; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.06em; }

  .viewport { position: relative; aspect-ratio: 16 / 11; font-size: clamp(10px, 2.55cqi, 15.5px); }
  .scene { position: absolute; inset: 0; padding: 1.6em 1.8em; display: grid; gap: 0.8em; align-content: center; opacity: 0; visibility: hidden; transition: opacity var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base); }
  .stage[data-scene='discover'] .s-discover,
  .stage[data-scene='evaluate'] .s-evaluate,
  .stage[data-scene='prepare'] .s-prepare,
  .stage[data-scene='track'] .s-track { opacity: 1; visibility: visible; transition-delay: 0s; }

  .pill { display: inline-flex; align-items: center; gap: 0.4em; font-size: 0.78em; font-weight: 600; padding: 0.35em 0.75em; border-radius: 999px; background: var(--stage-surface-2); color: var(--stage-ink); white-space: nowrap; }
  .pill.ghost { background: transparent; border: 1px solid var(--stage-line); color: var(--stage-ink-2); }
  .pill.lime { background: var(--stage-lime); color: #15110e; }
  .pill.amber { background: rgb(243 181 77 / 0.18); color: var(--stage-amber); }
  .pill.tide { background: rgb(87 214 198 / 0.16); color: var(--stage-tide); }

  /* discover */
  .s-head { display: flex; gap: 0.6em; flex-wrap: wrap; }
  .job { display: grid; grid-template-columns: 1fr auto; gap: 0.15em 1em; align-items: center; background: var(--stage-surface); border: 1px solid var(--stage-line); border-radius: 1em; padding: 0.95em 1.15em; }
  .job b { font-size: 1.15em; font-family: var(--font-display); letter-spacing: -0.01em; }
  .job span { grid-column: 1; color: var(--stage-ink-2); font-size: 0.9em; }
  .job .tag { grid-row: 1 / span 2; grid-column: 2; font-style: normal; font-size: 0.75em; font-weight: 600; padding: 0.35em 0.7em; border-radius: 999px; border: 1px solid var(--stage-line); color: var(--stage-ink-2); }
  .job .tag.lime { background: var(--stage-lime); color: #15110e; border-color: transparent; }
  .job.j1 { border-color: rgb(213 246 94 / 0.55); box-shadow: 0 0 0 4px rgb(213 246 94 / 0.08); }
  .run .s-discover .job { animation: deal var(--dur-slow) var(--ease-out) both; }
  .run .s-discover .j2 { animation-delay: calc(var(--stagger) * 2); }
  .run .s-discover .j3 { animation-delay: calc(var(--stagger) * 4); }
  .run .s-discover .j1 .tag { animation: pop var(--dur-base) var(--ease-bounce) both; animation-delay: calc(var(--dur-slow) + var(--stagger) * 6); }
  @keyframes deal { from { opacity: 0; transform: translateY(1.6em) rotate(-1.5deg) scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes pop { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: none; } }

  /* evaluate */
  .s-evaluate { grid-template-columns: auto 1fr; gap: 1.6em; align-items: center; }
  .gauge { position: relative; width: 9.5em; }
  .gauge svg { width: 100%; transform: rotate(-90deg); }
  .gauge circle { fill: none; stroke-width: 10; }
  .gauge .track { stroke: var(--stage-surface-2); }
  .gauge .fill { stroke: var(--stage-lime); stroke-linecap: round; stroke-dasharray: 84 100; }
  .run .s-evaluate .gauge .fill { animation: gauge var(--dur-story) var(--ease-out) both; }
  @keyframes gauge { from { stroke-dasharray: 0 100; } }
  .score { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .score b { font-family: var(--font-display); font-size: 2.6em; line-height: 1; letter-spacing: -0.04em; }
  .score span { font-size: 0.8em; color: var(--stage-ink-2); }
  .crit { display: grid; gap: 0.55em; min-width: 0; }
  .row { display: grid; grid-template-columns: 8.5em 1fr; gap: 0.8em; align-items: center; font-size: 0.85em; color: var(--stage-ink-2); }
  .row i { height: 0.55em; border-radius: 999px; background: var(--stage-surface-2); position: relative; overflow: hidden; }
  .row i::after { content: ''; position: absolute; inset: 0; width: var(--w); background: var(--stage-tide); border-radius: inherit; transform-origin: left; }
  .run .s-evaluate .row i::after { animation: bar var(--dur-slow) var(--ease-out) both; }
  .run .s-evaluate .row:nth-child(2) i::after { animation-delay: var(--stagger); }
  .run .s-evaluate .row:nth-child(3) i::after { animation-delay: calc(var(--stagger) * 2); }
  .run .s-evaluate .row:nth-child(4) i::after { animation-delay: calc(var(--stagger) * 3); }
  @keyframes bar { from { transform: scaleX(0); } }
  .evidence { font-family: var(--font-mono); font-size: 0.78em; color: var(--stage-ink-2); border-left: 2px solid var(--stage-tide); padding-left: 0.8em; margin-top: 0.3em; }
  .evidence mark { background: rgb(87 214 198 / 0.22); color: var(--stage-ink); border-radius: 3px; padding: 0 0.15em; }
  .missing, .elig { font-size: 0.82em; display: flex; gap: 0.6em; align-items: center; color: var(--stage-ink-2); }
  .run .s-evaluate .evidence, .run .s-evaluate .missing, .run .s-evaluate .elig { animation: rise var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--dur-slow) + var(--stagger) * 2); }
  .run .s-evaluate .elig { animation-delay: calc(var(--dur-slow) + var(--stagger) * 4); }
  @keyframes rise { from { opacity: 0; transform: translateY(0.8em); } }

  /* prepare */
  .s-prepare { grid-template-columns: 1fr 1fr; gap: 1.2em; align-items: start; }
  .page { background: #f8f3ea; color: #1c1714; border-radius: 0.6em; padding: 1.1em; display: grid; gap: 0.45em; align-content: start; min-height: 15em; box-shadow: 0 1.2em 2.4em -1em rgb(0 0 0 / 0.6); }
  .page b { font-family: var(--font-display); font-size: 1.1em; }
  .page .sec { font-size: 0.62em; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: #a8380f; margin-top: 0.4em; }
  .ln { height: 0.45em; border-radius: 999px; background: #ddd2c3; }
  .ln.hi { background: linear-gradient(90deg, #0d7068 0 0.35em, #cfe9e3 0.35em); }
  .w40 { width: 40%; } .w50 { width: 50%; } .w60 { width: 60%; } .w70 { width: 70%; } .w80 { width: 80%; } .w85 { width: 85%; } .w90 { width: 90%; } .w95 { width: 95%; }
  .ph { font-family: var(--font-mono); font-size: 0.7em; color: #8a5300; background: #fbecc9; padding: 0.2em 0.4em; border-radius: 4px; justify-self: start; }
  .p-letter { transform: rotate(2deg) translateY(1.2em); }
  .p-resume { transform: rotate(-2deg); }
  .exports { grid-column: 1 / -1; display: flex; gap: 0.6em; align-items: center; flex-wrap: wrap; margin-top: 0.4em; }
  .check { font-size: 0.8em; color: var(--stage-tide); font-weight: 600; }
  .run .s-prepare .p-resume { animation: fanL var(--dur-slow) var(--ease-out) both; }
  .run .s-prepare .p-letter { animation: fanR var(--dur-slow) var(--ease-out) both; animation-delay: var(--stagger); }
  .run .s-prepare .ln { animation: draw var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--dur-base) + var(--stagger)); transform-origin: left; }
  .run .s-prepare .exports > * { animation: pop var(--dur-base) var(--ease-bounce) both; animation-delay: calc(var(--dur-slow) + var(--stagger) * 3); }
  .run .s-prepare .exports > :nth-child(2) { animation-delay: calc(var(--dur-slow) + var(--stagger) * 4); }
  .run .s-prepare .exports > :nth-child(3) { animation-delay: calc(var(--dur-slow) + var(--stagger) * 6); }
  @keyframes fanL { from { opacity: 0; transform: rotate(0) translateX(30%); } }
  @keyframes fanR { from { opacity: 0; transform: rotate(0) translate(-30%, 1.2em); } }
  @keyframes draw { from { transform: scaleX(0); } }

  /* track */
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7em; }
  .col { background: var(--stage-surface); border: 1px solid var(--stage-line); border-radius: 0.9em; padding: 0.7em; display: grid; gap: 0.6em; align-content: start; min-height: 9.5em; }
  .ch { font-size: 0.72em; text-transform: uppercase; letter-spacing: 0.08em; color: var(--stage-ink-2); font-weight: 600; }
  .card { background: var(--stage-surface-2); border-radius: 0.7em; padding: 0.7em 0.8em; display: grid; gap: 0.15em; border: 1px solid var(--stage-line); }
  .card b { font-size: 0.92em; }
  .card span { font-size: 0.78em; color: var(--stage-ink-2); }
  .slot { border: 1.5px dashed var(--stage-line); border-radius: 0.7em; height: 3.6em; }
  .c-move { position: relative; z-index: 2; border-color: rgb(213 246 94 / 0.6); }
  .run .s-track .c-move { animation: hop calc(var(--dur-story) * 1.2) var(--ease-in-out) both; animation-delay: calc(var(--dur-slow) * 2); }
  @keyframes hop {
    0% { transform: none; }
    50% { transform: translate(55%, -1.8em) rotate(3deg); }
    100% { transform: translate(calc(100% + 1.75em), 0); }
  }
  .confirm { display: flex; align-items: center; gap: 0.6em; font-size: 0.85em; color: var(--stage-ink); }
  .box { width: 1.1em; height: 1.1em; border-radius: 0.3em; border: 1.5px solid var(--stage-ink-2); position: relative; }
  .box::after { content: ''; position: absolute; left: 0.32em; top: 0.08em; width: 0.3em; height: 0.6em; border: solid #15110e; border-width: 0 2px 2px 0; transform: rotate(45deg) scale(0); }
  .run .s-track .box { animation: boxOn var(--dur-base) var(--ease-out) both; animation-delay: var(--dur-slow); }
  .run .s-track .box::after { animation: tickOn var(--dur-base) var(--ease-bounce) both; animation-delay: var(--dur-slow); }
  @keyframes boxOn { to { background: var(--stage-lime); border-color: var(--stage-lime); } }
  @keyframes tickOn { to { transform: rotate(45deg) scale(1); } }
  .trail { display: flex; gap: 0.5em; flex-wrap: wrap; font-family: var(--font-mono); font-size: 0.7em; color: var(--stage-ink-2); }
  .trail span { border: 1px solid var(--stage-line); border-radius: 999px; padding: 0.25em 0.6em; }
  .trail .new { color: var(--stage-lime); border-color: rgb(213 246 94 / 0.5); }
  .run .s-track .trail .new { animation: rise var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--dur-slow) * 2 + var(--dur-story)); }

  /* ---------- arc stepper ---------- */
  .arc { position: relative; margin: 0.4rem 1rem 0.6rem; height: 5.4rem; }
  .arc-line { position: absolute; inset: 0 0 auto; width: 100%; height: 3.4rem; overflow: visible; }
  .arc-path { fill: none; stroke: var(--stage-line); stroke-width: 2; stroke-dasharray: 4 6; vector-effect: non-scaling-stroke; }
  .ball {
    position: absolute; top: 0; left: 0; width: 100%; height: 3.4rem; pointer-events: none;
  }
  .ball::after {
    content: ''; position: absolute; width: 14px; height: 14px; border-radius: 50%; background: var(--stage-lime);
    box-shadow: 0 0 0 6px rgb(213 246 94 / 0.16), 0 0 18px rgb(213 246 94 / 0.6);
